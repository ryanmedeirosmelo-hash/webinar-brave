# ─────────────────────────────────────────────────────────────
# Supabase (banco + storage do vídeo)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# ─────────────────────────────────────────────────────────────
# Acesso ao painel (/admin)
# ADMIN_SESSION_TOKEN: gere um valor aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_TOKEN=gere_um_token_aleatorio_64_hex

# ─────────────────────────────────────────────────────────────
# Marca (white label) — tudo opcional, tem padrão sensato
# ─────────────────────────────────────────────────────────────
# Nome da instalação: aparece no painel e no título das páginas.
NEXT_PUBLIC_APP_NAME=AutoWebinar
# Título da aba do navegador (padrão: NEXT_PUBLIC_APP_NAME).
# NEXT_PUBLIC_SITE_TITLE=Aulas ao vivo da Escola X
# Logo do painel (URL ou caminho em /public). Sem isso, só o wordmark.
# NEXT_PUBLIC_ADMIN_LOGO_URL=/brand/logo.png
# Cor de destaque do painel.
# NEXT_PUBLIC_ADMIN_ACCENT=#cbad78
# Fuso usado para agrupar/exibir datas nos relatórios do painel.
# NEXT_PUBLIC_ADMIN_TIMEZONE=America/Sao_Paulo

# ─────────────────────────────────────────────────────────────
# Comportamento por webinar (listas separadas por vírgula)
# ─────────────────────────────────────────────────────────────
# Slugs que NUNCA pedem cadastro (entrada livre): só cronômetro e sala.
# NEXT_PUBLIC_FREE_ENTRY_SLUGS=aula-seg,aula-qui
# Datas soltas (YYYY-MM-DD) com entrada livre — depois volta ao normal sozinho.
# NEXT_PUBLIC_FREE_ENTRY_DATES=2026-07-09
# Slugs que mostram contagem regressiva ANTES do dia (aula avulsa divulgada
# com antecedência); sem isso, fora do dia a tela é "aula encerrada".
# NEXT_PUBLIC_PRE_COUNTDOWN_SLUGS=aula-avulsa

# ─────────────────────────────────────────────────────────────
# Domínios (opcional) — separe painel e área do lead
# Sem nada disso, tudo roda num domínio só.
# ─────────────────────────────────────────────────────────────
# ADMIN_HOST=painel.seudominio.com
# LEADS_HOST=aula.seudominio.com
# REDIRECT_TO_LEADS_HOSTS=seudominio.com,www.seudominio.com

# ─────────────────────────────────────────────────────────────
# Integrações (opcionais)
# ─────────────────────────────────────────────────────────────
# Hotmart: token do Postback 2.0 (Ferramentas → Webhook). Sem ele o webhook
# aceita qualquer POST — configure em produção.
# HOTMART_HOTTOK=seu_hottok

# Painel "Disparos": lê (somente leitura) o banco de um CRM com fluxos de
# automação, para cruzar quem foi convidado no WhatsApp × quem assistiu.
# Sem estas três envs a aba apenas informa que a integração está desligada.
# CRM_SUPABASE_URL=https://CRM.supabase.co
# CRM_SUPABASE_SERVICE_ROLE_KEY=service_role_do_crm
# CRM_WEBINAR_TENANT_ID=tenant-do-webinario
